#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    long long vol = 0;
    long long m = LLONG_MIN;
    long long mm = LLONG_MIN;
    for (int i = 0; i < n; i++) {
        long long x;
        cin >> x;
        vol += x;
    }
    for (int i = 0; i < n; i++) {
        long long x;
        cin>>x;
        if (x > m) {
            mm = m;
            m = x;
        }
        else if (x > mm) {
            mm = x;
        }
    }
    if (m + mm >= vol)
        cout << "YES";
    else
        cout << "NO";

    return 0;
}
