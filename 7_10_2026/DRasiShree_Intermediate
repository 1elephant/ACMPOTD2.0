Intermediate code : search pretty numbers
#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    int m;
    cin>>n;
    cin>>m;
    vector<vector<int>> v(10,vector<int>(2,0));
    for (int i=0;i<n;i++){
        int value;
        cin>>value;
        v[value][0]=1;
    }
    for(int i=0;i<m;i++){
        int value;
        cin>>value;
        v[value][1]=1;
    }
    int i=INT_MAX;
    int j=INT_MAX;
    int c=INT_MAX;
    for(int k=1;k<10;k++){
        if(v[k][0]==1){
            i=min(i,k);
        }
        if(v[k][1]==1){
            j=min(j,k);
        }
        if(v[k][0]==1 && v[k][1]==1){
            c=min(c,k);
            cout<<c;
            return 0;
        }
    }
    cout<<min(i,j)<<max(i,j);
}
