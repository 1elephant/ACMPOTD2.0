Intermediate Solution : A Tricky Sum
#include<bits/stdc++.h>
using namespace std;

void printsum(long long n){
    long long sum=n*(n+1)/2;
    long long p=1;
    while(p<=n){
        sum-=(2*p);
        p=p<<1;
    }
    cout<<sum<<endl;
}
int main(){
    int t;
    cin>> t;
    for(int i=0;i<t;i++){
        long long n;
        cin>> n;
        printsum(n);
    }
    return 0;
}
